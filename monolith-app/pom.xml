<?xml version="1.0" encoding="UTF-8"?>
<!--
  模块化单体应用：auth、user、product、inventory、order 五个业务模块 + 共享内核，打成一个 jar 部署。
  依赖清单以 Spring Initializr 生成的为基线，增删的原因写在每个依赖旁边。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>java-monolith-scaffold</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>monolith-app</artifactId>
    <name>monolith-app</name>
    <description>模块化单体应用</description>

    <properties>
        <!-- surefire / failsafe 的 JVM 参数占位：JaCoCo 会在运行时往里填探针参数 -->
        <argLine/>
    </properties>

    <dependencies>
        <!-- ===== 本工程的手写 starter：traceId + 访问日志 ===== -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>trace-spring-boot-starter</artifactId>
        </dependency>

        <!-- ===== Web ===== -->
        <!-- Spring Boot 4 把 starter 拆得更细：Spring MVC 是 spring-boot-starter-webmvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- 参数校验（Jakarta Bean Validation + Hibernate Validator） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ===== 安全：Spring Security + 用 OAuth2 Resource Server 自带的 JWT 校验，不手写过滤器 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <!-- ===== 持久层：MyBatis-Plus（选型理由见 ADR）+ Flyway 管理表结构 ===== -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <!-- 分页插件从 3.5.9 起拆到了单独的 jsqlparser 模块 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Flyway 10 起，MySQL 支持拆成了单独的模块 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <!-- 默认数据库：H2 内存库（MySQL 兼容模式），clone 下来不装任何东西就能跑 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- mysql profile 下使用 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== 模块化：Spring Modulith ===== -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <!--
          事件发布登记表（Event Publication Registry）的 JDBC 实现：
          事件和业务数据在同一个事务里落库，监听器处理成功才标记完成，失败的可以重投——相当于进程内的"本地消息表"。
        -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-jdbc</artifactId>
        </dependency>
        <!-- /actuator/modulith：运行时查看模块结构 -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-actuator</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-runtime</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== 缓存：默认 Caffeine（进程内），redis profile 换成 Redis ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ===== 运维：健康检查、指标 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 暴露 /actuator/prometheus，给 Prometheus 抓取 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== 测试 ===== -->
        <!-- MockMvc、@WebMvcTest 切片，同时带上 JUnit Jupiter、AssertJ、Mockito -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          没有用 MyBatis-Plus 自带的测试切片 mybatis-plus-spring-boot4-starter-test：
          3.5.17 的 @MybatisPlusTest 元注解还引用着 Spring Boot 3 的包，在 Boot 4 下会被 JVM 静默忽略，
          切片退化成全量扫描。持久层切片改用 Boot 4 的 @JdbcTest 组合，见测试代码里的 MybatisSliceTest。
        -->
        <!-- 模块测试 @ApplicationModuleTest、事件断言 Scenario、模块依赖校验 -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 异步断言：等事件监听器处理完再检查结果 -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- 打出来的 jar 固定叫 monolith-app.jar，Dockerfile 和运行脚本不用跟着版本号改 -->
        <finalName>monolith-app</finalName>
        <plugins>
            <!-- 打可执行 jar；默认开启分层（layers），Dockerfile 按层拆分以复用镜像缓存 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <!-- 生成 @ConfigurationProperties 的元数据，application.yml 里有提示 -->
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- 把每个依赖的 jar 路径设成属性（如 ${org.mockito:mockito-core:jar}），下面挂 Mockito 代理要用 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              单元测试和切片测试：*Test，test 阶段运行，要快。
              JDK 21+ 不再鼓励运行时动态挂载 Java Agent，Mockito 官方建议启动时用 -javaagent 显式挂上。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                </configuration>
            </plugin>
            <!-- 集成测试：*IT，integration-test 阶段运行，启动完整的 Spring 容器 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                </configuration>
            </plugin>
            <!-- 覆盖率：收集单元测试和集成测试的数据，报告在 target/site/jacoco -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>prepare-agent-integration</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                            <goal>report-integration</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
